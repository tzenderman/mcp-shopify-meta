# Required: Shopify stores (JSON array). Each store authenticates one of two ways:
#   - Static token:        {"store_name","shopify_url","token":"shpat_xxx"}
#   - Client credentials:  {"store_name","shopify_url","client_id":"...","client_secret":"..."}
#     (the server exchanges these for a short-lived token at request time and
#      re-fetches on expiry or on a 401 — preferred for Dev Dashboard apps whose
#      tokens expire in ~24h)
SHOPIFY_STORES='[{"store_name":"main","shopify_url":"https://main.myshopify.com","token":"shpat_xxx"}]'

# Optional (with defaults)
SHOPIFY_API_VERSION=2024-10
ISSUE_REPORT_PATH=./data/issue_reports.jsonl

# Logging
MCP_LOG_LEVEL=INFO
MCP_LOG_FILE=

# Sessions
SESSION_ENABLED=true
SESSION_TTL_DAYS=30

# HTTP transport
SERVER_URL=http://localhost:3000
HOST=0.0.0.0
PORT=3000

# ScaleKit OAuth (optional — server runs without auth if these are blank)
SCALEKIT_ENVIRONMENT_URL=
SCALEKIT_CLIENT_ID=
SCALEKIT_CLIENT_SECRET=
SCALEKIT_RESOURCE_ID=
SCALEKIT_INTERCEPTOR_SECRET=

# Email allowlist for interceptors (comma-separated). Empty = allow all.
ALLOWED_EMAILS=
